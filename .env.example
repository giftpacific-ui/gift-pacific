# ===========================================================================
# Gift Pacific: environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env or put real secrets in this file.
#
# Legend:  [REQUIRED]  the app will not work / start without it
#          [OPTIONAL]  a feature is simply off or uses a default when it is empty
#          [SERVER]    secret, read on the server only. Never prefix it with NEXT_PUBLIC_.
#
# src/lib/env.ts validates the core variables (database, auth, app URL, analytics, uploads) at startup.
# Courier, bKash, social-login, cron and refund-safety variables are read directly where they are used and are
# checked by the admin "Integrations" page (/admin/integrations), which shows which names are still empty.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Core (REQUIRED)
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# [REQUIRED] [SERVER] Long random secret used to sign session JWTs. Generate your own:  openssl rand -base64 48
# (Left blank on purpose: the app refuses to start until you set a real value, so a copied example file can
# never run with a publicly known secret.)
AUTH_SECRET=""

# [REQUIRED in production] Your PUBLIC address. Used for canonical URLs, sitemaps, structured data, OAuth and
# payment/courier callback URLs. Production must be https://your-domain (a startup check logs an error otherwise).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 2. App (OPTIONAL: defaults exist in src/lib/env.ts)
# ---------------------------------------------------------------------------
# "demo" makes /docs (roadmap page) publicly visible; any other value (e.g. "prod") redirects /docs to the homepage.
NEXT_PUBLIC_APP_ENV="prod"
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# ---------------------------------------------------------------------------
# 3. Image uploads (REQUIRED for admin image uploads)
# ---------------------------------------------------------------------------
# The admin panel uploads product/banner/logo images to Cloudinary. Without these, uploads fail with a clear error
# (the app does not crash).
UPLOAD_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# [SERVER]
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# 4. First admin account (REQUIRED once, when running `pnpm db:seed`)
# ---------------------------------------------------------------------------
# The seed is ADMIN-ONLY and fails closed. It creates exactly one thing: an admin user. No store settings, customers,
# categories, products, coupons, banners or orders are created (add those from the admin panel). Both variables are
# REQUIRED on every database, including local development: there is no default admin. A BLANK value counts as "not set".
# The password must be 12+ characters with lower-case, upper-case and a digit, must not be a known default and must
# not contain the email name. An existing admin is never modified.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Used ONLY by `pnpm user:set-password <email>` (pass it on the command line, do not store it in .env):
#   NEW_PASSWORD='...' pnpm user:set-password someone@example.com

# ---------------------------------------------------------------------------
# 5. Scheduled courier maintenance (OPTIONAL, but needed for status polling / auto-booking)
# ---------------------------------------------------------------------------
# Leave CRON_SECRET empty to DISABLE /api/courier/reconcile. Call it from any scheduler with:
#   Authorization: Bearer <CRON_SECRET>
# (Vercel Cron adds that header itself when CRON_SECRET is a project env var; Hobby plans only allow daily crons.)
# [SERVER] Generate with: openssl rand -base64 32
CRON_SECRET=""
# Automatic booking of CONFIRMED orders by the reconcile job. Keep "false" until a real test booking succeeded.
COURIER_AUTO_BOOK="false"

# ---------------------------------------------------------------------------
# 6. Courier: Steadfast is the ONLY courier adapter (OPTIONAL)
# ---------------------------------------------------------------------------
# Pathao and RedX are NOT available: there is no adapter and no variable names for them, because their official API
# documentation and merchant credentials have not been provided. Do not add variables for them until it exists.
# The Steadfast adapter is UNVERIFIED against the live API: test with one real parcel before relying on it.
#
# ---- 6a. Legacy names (still honoured, unchanged) --------------------------
# They apply to the courier named by COURIER_PROVIDER. Leave it as "none" for manual courier entry only.
COURIER_PROVIDER="none"
# [SERVER]
COURIER_API_KEY=""
# [SERVER]
COURIER_API_SECRET=""
# Optional override of the provider's API base URL (https only).
COURIER_API_BASE_URL=""
# [SERVER] Shared secret the courier sends (Authorization: Bearer ...) to POST /api/courier/webhook.
# Use a long random value:  openssl rand -base64 32
COURIER_WEBHOOK_SECRET=""
# Per-request timeout in ms (1000-30000, default 10000).
COURIER_TIMEOUT_MS="10000"
# Optional tracking-link template, only if you know your courier's public URL. {id} = the tracking code.
# Example: https://courier.example/track/{id}
COURIER_TRACKING_URL_TEMPLATE=""
#
# ---- 6b. Per-provider names (new style; when set they win over the legacy twin) ----
# Which courier is used when none is chosen: COURIER_DEFAULT_PROVIDER, else COURIER_PROVIDER, else the first configured.
# COURIER_DEFAULT_PROVIDER="steadfast"
# STEADFAST_ENABLED="true"            # "false" switches it off without removing credentials
# STEADFAST_API_KEY=""                # [SERVER]
# STEADFAST_API_SECRET=""             # [SERVER]
# STEADFAST_WEBHOOK_SECRET=""         # [SERVER] give the courier <NEXT_PUBLIC_APP_URL>/api/courier/webhook/steadfast
# STEADFAST_API_BASE_URL=""
# STEADFAST_TIMEOUT_MS="10000"
# STEADFAST_TRACKING_URL_TEMPLATE=""  # [SERVER] customer "Track Parcel" link, built after a successful booking. https URL containing {id}.
#                                     # {id} is replaced by Steadfast's tracking_code (URL-encoded). Empty/invalid template, or a booking
#                                     # without a tracking code = no link is saved (never a guessed one). {id} may not be part of the host.
#                                     # No URL is assumed official or shipped as a default: copy the exact public tracking-page URL from your
#                                     # Steadfast merchant panel / account manager. Shape only (placeholder domain, NOT real):
#                                     # STEADFAST_TRACKING_URL_TEMPLATE="https://tracking.your-courier.example/track/{id}"
#                                     # Applies to NEW bookings only; existing orders keep the link they already have.
# STEADFAST_INVOICE_LOOKUP="false"    # "true" lets the app ask Steadfast whether a parcel already exists for an order number, to settle an UNCERTAIN
#                                     # booking. Off by default: that endpoint is not in Steadfast's current official Postman collection - confirm it on staging first.

# ---------------------------------------------------------------------------
# 7. bKash online payment for ADVANCE payments (OPTIONAL; all [SERVER] secrets)
# ---------------------------------------------------------------------------
# UNVERIFIED: the bKash Tokenized Checkout contract in this code was taken from third-party client documentation, not
# bKash's own portal, and has never run against a bKash account. Run a full sandbox payment (create -> approve ->
# execute -> refund) before using BKASH_ENV="production".
# Active only when BKASH_ENABLED=true AND the four credentials below are set; until then no "Pay with bKash" button
# is shown. Register this callback URL with bKash:  <NEXT_PUBLIC_APP_URL>/api/payments/bkash/callback
BKASH_ENABLED="false"
BKASH_ENV="sandbox"                   # "sandbox" or "production"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Optional: override the default bKash API base URL (https only) and the request timeout in ms (3000-60000).
# BKASH_BASE_URL=""
# BKASH_TIMEOUT_MS="20000"
# Optional server-to-server notifications (SNS-signed). Set the topic ARN bKash gives you and register
#   <NEXT_PUBLIC_APP_URL>/api/payments/bkash/ipn
# as the notification endpoint. Without this value the endpoint is switched off (404). A notification only triggers a
# server-side re-check with bKash; it never credits a payment by itself.
# BKASH_IPN_TOPIC_ARN=""
# Optional: from this amount (BDT) a manual "what the bKash dashboard shows" decision on an uncertain refund needs a
# SECOND, different admin. Unset or 0 = off (one admin can resolve it, still with evidence reference + note).
# GATEWAY_REFUND_ATTESTATION_APPROVAL_THRESHOLD="5000"
# Not integrated (no official contract): Nagad. Not to be integrated: SSLCommerz.

# ---------------------------------------------------------------------------
# 8. Rate limiting (OPTIONAL)
# ---------------------------------------------------------------------------
# Defaults to on. Set "false" only for local debugging.
# RATE_LIMIT_ENABLED="true"

# ---------------------------------------------------------------------------
# 9. Social login (OPTIONAL)
# ---------------------------------------------------------------------------
# Each provider is enabled ONLY when BOTH of its values are set (and NEXT_PUBLIC_APP_URL is the real public URL).
# With nothing set, no "Continue with ..." button is shown and the routes return 404. SERVER-ONLY secrets.
#
# Google:   Manual setup in Google Cloud Console (not done by this code):
#             1. APIs & Services -> OAuth consent screen: set app name, support email, and publish it ("In production")
#                so customers outside your test-user list can sign in. Scopes used: openid, email, profile (non-sensitive).
#             2. APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> "Web application".
#             3. Authorized redirect URIs (exact match, incl. https and no trailing slash), one per environment:
#                  <NEXT_PUBLIC_APP_URL>/api/auth/oauth/google/callback
#                  e.g. https://your-store.example/api/auth/oauth/google/callback
#                  local dev: http://localhost:3000/api/auth/oauth/google/callback
#             4. Copy the client ID and client secret into the two values below (server environment only; never commit them,
#                never prefix with NEXT_PUBLIC_). No "Authorized JavaScript origins" are needed: the flow is server-side.
#           A customer who signs in with Google using an email that already has an email+password account is asked for that
#           account's password once; the Google account is then linked to it (no duplicate account is created).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: Meta for Developers -> Create app (Consumer) -> add "Facebook Login".
#           Valid OAuth Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/facebook/callback
#           The app needs the "email" permission, a privacy-policy URL, and Live mode before real customers can sign in.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ---------------------------------------------------------------------------
# 10. Analytics (OPTIONAL)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=""                 # Google Tag Manager container ID
NEXT_PUBLIC_META_PIXEL_ID=""          # Meta (Facebook) Pixel ID
# [SERVER] Meta Conversions API access token, for server-side purchase events (src/lib/analytics/server-events.ts).
# NEVER prefix with NEXT_PUBLIC_. The server Purchase is sent when an order is CONFIRMED (not when it is placed); see HANDOFF_GIFTPACIFIC.md.
META_CONVERSIONS_API_TOKEN=""
# [SERVER, optional] Graph API version used for the Conversions API (default v25.0). Change only when Meta retires the current one.
META_GRAPH_API_VERSION=""
# [SERVER, optional] Events Manager "Test events" code. While set, events appear under Test Events and are NOT used for optimisation:
# remove it for production. The admin diagnostics panel warns if it is set in production.
META_CAPI_TEST_EVENT_CODE=""
# [SERVER] GA4 Measurement Protocol API secret, for the server-side GA4 purchase (src/lib/analytics/ga4-mp.ts). GA4 Admin -> Data streams ->
# your web stream -> Measurement Protocol API secrets. NEVER prefix with NEXT_PUBLIC_. While it is set, the SERVER is the only sender of the
# GA4 purchase (the browser skips it). It is carried in the request URL by Google's design: it is redacted from every log and stored error.
GA4_API_SECRET=""
# [SERVER, optional] GA4 measurement id (G-XXXX) for server events. Needed only when the storefront loads GA4 through a GTM container
# (a GTM-XXXX id is not a measurement id); otherwise the storefront's own G- id is used. Public value, not a secret.
GA4_MEASUREMENT_ID=""
# [SERVER, optional] true = send GA4 purchases to Google's VALIDATION endpoint: problems are reported in the admin panel but NOTHING is recorded.
# Use while setting up, then remove.
GA4_MP_DEBUG=""
# Retries / back-fills undelivered server events. Call /api/tracking/retry from a scheduler (every 5-15 min) with
#   Authorization: Bearer <CRON_SECRET>   (same secret as /api/courier/reconcile; empty CRON_SECRET disables it).

# ---------------------------------------------------------------------------
# 11. Reserved, UNUSED by this build (legacy placeholders; leave empty)
# ---------------------------------------------------------------------------
# Checkout accepts Cash on Delivery plus the manual wallet-reference flow and, when configured above, bKash for the
# advance. Stripe and SSLCommerz are NOT integrated (SSLCommerz is explicitly out of scope). These names are only
# validated by src/lib/env.ts so that old .env files keep loading.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# --- Courier fraud / delivery-history check (P6) -------------------------------------------------------------------------------------------------
# The advance policy and the admin "Courier fraud check" page ask the couriers how parcels sent to the customer's phone ended (delivered / cancelled).
#  * Steadfast: ON automatically once the Steadfast courier credentials above are valid. It reuses STEADFAST_API_KEY / STEADFAST_API_SECRET /
#    STEADFAST_API_BASE_URL (GET /fraud_check/{phone}); it needs no extra credentials. STEADFAST_ENABLED="false" switches it off too.
#  * Pathao and REDX: NOT supported. Neither courier documents a customer-history lookup, so nothing is called for them and no variables exist.
#    (When one documents it, an adapter plus its credentials will be added; setting variables for them today has no effect.)
# FRAUD_CHECK_ENABLED="true"            # "false" switches every courier history lookup off (customers then get the standard, unrated handling)
# FRAUD_CHECK_PROVIDER=""               # leave empty or "steadfast"; "none" switches the lookup off (kept for older deployments)
# FRAUD_CHECK_TIMEOUT_MS="3000"         # 500-10000; a slower answer counts as unavailable and checkout continues
# FRAUD_CHECK_CACHE_SECONDS="600"       # 0-86400; how long a saved answer is reused (0 = never). Failures are remembered for at most 30 s
# FRAUD_CHECK_MAX_CALLS_PER_MINUTE="60" # 1-1000; per courier, shared by all servers; over budget = unavailable, never a blocked checkout
# COURIER_INTEL_RETENTION_DAYS="90"     # 7-730; saved lookups older than this are deleted by the scheduled /api/courier/reconcile job

# --- Incomplete checkout recovery (P7.2) ----------------------------------------------------------------------------------------------------------
# Checkout progress is saved (only after the customer ticks the notice box and gave a valid e-mail/phone) so staff can see unfinished checkouts. Nothing is sent to customers.
# CHECKOUT_RECOVERY_ENABLED="true"       # "false" switches saving off (the checkout notice disappears too)
# CHECKOUT_RECOVERY_EXPIRY_DAYS="30"     # 1-365; an open record idle this long is marked EXPIRED and its personal details are erased
# CHECKOUT_RECOVERY_PURGE_DAYS="60"      # 7-730; an EXPIRED record (no order) is deleted this long after it expired. Records linked to an order are never deleted
# Cleanup runs from POST/GET /api/checkout-recovery/cleanup with `Authorization: Bearer $CRON_SECRET` (schedule it daily) or from the admin page button.

# --- E-mail: Gmail SMTP (P7.3.1) -----------------------------------------------------------------------------------------------------------------
# Server-side only (never NEXT_PUBLIC_*). Leave SMTP_USER and SMTP_PASS empty to keep e-mail OFF. The only thing that sends e-mail so far is the admin test e-mail (Admin -> Store settings -> E-mail (SMTP)).
# Gmail setup: 1. Turn on 2-Step Verification for the Google account. 2. Google Account -> Security -> App passwords -> create one ("GiftPacific").
#              3. Put the 16-character App Password in SMTP_PASS (spaces are ignored). A normal Google password will NOT work.
#              4. Run `pnpm smtp:verify`. Gmail rewrites the sender to SMTP_USER unless SMTP_FROM_EMAIL is added under Gmail -> Settings -> Accounts -> "Send mail as".
# Ports: 587 + SMTP_SECURE=false (STARTTLS, required), or 465 + SMTP_SECURE=true (SSL). Any other combination is reported as invalid.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=GiftPacific
SMTP_FROM_EMAIL=

# --- E-mail queue (P7.3.3) ----------------------------------------------------------------------------------------------------------------------
# A PostgreSQL-backed queue (no Redis). Nothing in the store enqueues e-mail yet: this is the foundation for transactional e-mails and later campaigns.
# NOTE (Vercel Hobby, event-driven mode): nothing in this project calls the queue on a timer. E-mail is sent only when an admin clicks Send now / Continue sending /
# Send reminders (abandoned carts) / Retry (Email marketing > Send queue): one bounded batch (max 20, within the limits below) per click, inside that request.
# The scheduler-driven route below is optional, protected, and unused unless YOU configure an external caller (which would add automatic processing).
# Drain it from any scheduler every 1-5 minutes:   POST /api/email/queue   with   Authorization: Bearer <CRON_SECRET>   (same secret as the other jobs;
# empty CRON_SECRET disables the route). Jobs wait PENDING while SMTP is not configured; nothing is lost and no attempt is used up.
# Sending limits (all optional; unusable values fall back to the default). Defaults stay under Gmail's ~500 recipients/day for a free account.
#   EMAIL_QUEUE_BATCH_SIZE    most e-mails one run starts (1-100, default 20)
#   EMAIL_QUEUE_MAX_PER_HOUR  most e-mails accepted per rolling hour (1-1000, default 100)
#   EMAIL_QUEUE_MAX_PER_DAY   most e-mails accepted per rolling 24 hours (1-5000, default 400)
# EMAIL_QUEUE_BATCH_SIZE=20
# EMAIL_QUEUE_MAX_PER_HOUR=100
# EMAIL_QUEUE_MAX_PER_DAY=400


# --- E-mail unsubscribe (Prompt 11) ---------------------------------------------------------------------------------------------------------------
# Every marketing campaign e-mail carries the recipient's unsubscribe link ({{unsubscribeUrl}}) plus List-Unsubscribe / List-Unsubscribe-Post
# (RFC 8058 one-click) headers. The link is <NEXT_PUBLIC_APP_URL>/api/email/unsubscribe/<token>; the token is derived from this secret, so the SAME
# link keeps working for every campaign a person ever receives. Server-side only (never NEXT_PUBLIC_*).
#   - Generate one:  openssl rand -base64 48      (at least 32 characters)
#   - It must be its OWN secret: never AUTH_SECRET, CRON_SECRET, SMTP_PASS or any public value (such a value is rejected).
#   - Leave it empty and campaigns are REFUSED at dispatch (there is no fallback and no way to send without a link).
#   - CHANGING it invalidates every unsubscribe link already e-mailed (use that only after a leak). Keep a backup.
#   - NEXT_PUBLIC_APP_URL must be your public https:// origin (no path); http://localhost is accepted outside production only.
EMAIL_UNSUBSCRIBE_SECRET=""
