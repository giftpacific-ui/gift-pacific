# ===========================================================================
# Gift Pacific: environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env or put real secrets in this file.
#
# Legend:  [REQUIRED]  the app will not work / start without it
#          [OPTIONAL]  a feature is simply off or uses a default when it is empty
#          [SERVER]    secret, read on the server only. Never prefix it with NEXT_PUBLIC_.
#
# src/lib/env.ts validates the core variables (database, auth, app URL, analytics, uploads) at startup.
# Courier, bKash, social-login, cron and refund-safety variables are read directly where they are used and are
# checked by the admin "Integrations" page (/admin/integrations), which shows which names are still empty.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Core (REQUIRED)
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# [REQUIRED] [SERVER] Long random secret used to sign session JWTs. Generate your own:  openssl rand -base64 48
# (Left blank on purpose: the app refuses to start until you set a real value, so a copied example file can
# never run with a publicly known secret.)
AUTH_SECRET=""

# [REQUIRED in production] Your PUBLIC address. Used for canonical URLs, sitemaps, structured data, OAuth and
# payment/courier callback URLs. Production must be https://your-domain (a startup check logs an error otherwise).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 2. App (OPTIONAL: defaults exist in src/lib/env.ts)
# ---------------------------------------------------------------------------
# "demo" makes /docs (roadmap page) publicly visible; any other value (e.g. "prod") redirects /docs to the homepage.
NEXT_PUBLIC_APP_ENV="prod"
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# ---------------------------------------------------------------------------
# 3. Image uploads (REQUIRED for admin image uploads)
# ---------------------------------------------------------------------------
# The admin panel uploads product/banner/logo images to Cloudinary. Without these, uploads fail with a clear error
# (the app does not crash).
UPLOAD_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# [SERVER]
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# 4. First admin account (REQUIRED once, when running `pnpm db:seed`)
# ---------------------------------------------------------------------------
# The seed is ADMIN-ONLY and fails closed. It creates exactly one thing: an admin user. No store settings, customers,
# categories, products, coupons, banners or orders are created (add those from the admin panel). Both variables are
# REQUIRED on every database, including local development: there is no default admin. A BLANK value counts as "not set".
# The password must be 12+ characters with lower-case, upper-case and a digit, must not be a known default and must
# not contain the email name. An existing admin is never modified.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Used ONLY by `pnpm user:set-password <email>` (pass it on the command line, do not store it in .env):
#   NEW_PASSWORD='...' pnpm user:set-password someone@example.com

# ---------------------------------------------------------------------------
# 5. Scheduled courier maintenance (OPTIONAL, but needed for status polling / auto-booking)
# ---------------------------------------------------------------------------
# Leave CRON_SECRET empty to DISABLE /api/courier/reconcile. Call it from any scheduler with:
#   Authorization: Bearer <CRON_SECRET>
# (Vercel Cron adds that header itself when CRON_SECRET is a project env var; Hobby plans only allow daily crons.)
# [SERVER] Generate with: openssl rand -base64 32
CRON_SECRET=""
# Automatic booking of CONFIRMED orders by the reconcile job. Keep "false" until a real test booking succeeded.
COURIER_AUTO_BOOK="false"

# ---------------------------------------------------------------------------
# 6. Courier: Steadfast is the ONLY courier adapter (OPTIONAL)
# ---------------------------------------------------------------------------
# Pathao and RedX are NOT available: there is no adapter and no variable names for them, because their official API
# documentation and merchant credentials have not been provided. Do not add variables for them until it exists.
# The Steadfast adapter is UNVERIFIED against the live API: test with one real parcel before relying on it.
#
# ---- 6a. Legacy names (still honoured, unchanged) --------------------------
# They apply to the courier named by COURIER_PROVIDER. Leave it as "none" for manual courier entry only.
COURIER_PROVIDER="none"
# [SERVER]
COURIER_API_KEY=""
# [SERVER]
COURIER_API_SECRET=""
# Optional override of the provider's API base URL (https only).
COURIER_API_BASE_URL=""
# [SERVER] Shared secret the courier sends (Authorization: Bearer ...) to POST /api/courier/webhook.
# Use a long random value:  openssl rand -base64 32
COURIER_WEBHOOK_SECRET=""
# Per-request timeout in ms (1000-30000, default 10000).
COURIER_TIMEOUT_MS="10000"
# Optional tracking-link template, only if you know your courier's public URL. {id} = the tracking code.
# Example: https://courier.example/track/{id}
COURIER_TRACKING_URL_TEMPLATE=""
#
# ---- 6b. Per-provider names (new style; when set they win over the legacy twin) ----
# Which courier is used when none is chosen: COURIER_DEFAULT_PROVIDER, else COURIER_PROVIDER, else the first configured.
# COURIER_DEFAULT_PROVIDER="steadfast"
# STEADFAST_ENABLED="true"            # "false" switches it off without removing credentials
# STEADFAST_API_KEY=""                # [SERVER]
# STEADFAST_API_SECRET=""             # [SERVER]
# STEADFAST_WEBHOOK_SECRET=""         # [SERVER] give the courier <NEXT_PUBLIC_APP_URL>/api/courier/webhook/steadfast
# STEADFAST_API_BASE_URL=""
# STEADFAST_TIMEOUT_MS="10000"
# STEADFAST_TRACKING_URL_TEMPLATE=""  # https URL containing {id}

# ---------------------------------------------------------------------------
# 7. bKash online payment for ADVANCE payments (OPTIONAL; all [SERVER] secrets)
# ---------------------------------------------------------------------------
# UNVERIFIED: the bKash Tokenized Checkout contract in this code was taken from third-party client documentation, not
# bKash's own portal, and has never run against a bKash account. Run a full sandbox payment (create -> approve ->
# execute -> refund) before using BKASH_ENV="production".
# Active only when BKASH_ENABLED=true AND the four credentials below are set; until then no "Pay with bKash" button
# is shown. Register this callback URL with bKash:  <NEXT_PUBLIC_APP_URL>/api/payments/bkash/callback
BKASH_ENABLED="false"
BKASH_ENV="sandbox"                   # "sandbox" or "production"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Optional: override the default bKash API base URL (https only) and the request timeout in ms (3000-60000).
# BKASH_BASE_URL=""
# BKASH_TIMEOUT_MS="20000"
# Optional server-to-server notifications (SNS-signed). Set the topic ARN bKash gives you and register
#   <NEXT_PUBLIC_APP_URL>/api/payments/bkash/ipn
# as the notification endpoint. Without this value the endpoint is switched off (404). A notification only triggers a
# server-side re-check with bKash; it never credits a payment by itself.
# BKASH_IPN_TOPIC_ARN=""
# Optional: from this amount (BDT) a manual "what the bKash dashboard shows" decision on an uncertain refund needs a
# SECOND, different admin. Unset or 0 = off (one admin can resolve it, still with evidence reference + note).
# GATEWAY_REFUND_ATTESTATION_APPROVAL_THRESHOLD="5000"
# Not integrated (no official contract): Nagad. Not to be integrated: SSLCommerz.

# ---------------------------------------------------------------------------
# 8. Rate limiting (OPTIONAL)
# ---------------------------------------------------------------------------
# Defaults to on. Set "false" only for local debugging.
# RATE_LIMIT_ENABLED="true"

# ---------------------------------------------------------------------------
# 9. Social login (OPTIONAL)
# ---------------------------------------------------------------------------
# Each provider is enabled ONLY when BOTH of its values are set (and NEXT_PUBLIC_APP_URL is the real public URL).
# With nothing set, no "Continue with ..." button is shown and the routes return 404. SERVER-ONLY secrets.
#
# Google:   Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
#           Authorized redirect URI:  <NEXT_PUBLIC_APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: Meta for Developers -> Create app (Consumer) -> add "Facebook Login".
#           Valid OAuth Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/facebook/callback
#           The app needs the "email" permission, a privacy-policy URL, and Live mode before real customers can sign in.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ---------------------------------------------------------------------------
# 10. Analytics (OPTIONAL)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=""                 # Google Tag Manager container ID
NEXT_PUBLIC_META_PIXEL_ID=""          # Meta (Facebook) Pixel ID
# [SERVER] Meta Conversions API access token, for server-side purchase events (src/lib/analytics/server-events.ts).
META_CONVERSIONS_API_TOKEN=""

# ---------------------------------------------------------------------------
# 11. Reserved, UNUSED by this build (legacy placeholders; leave empty)
# ---------------------------------------------------------------------------
# Checkout accepts Cash on Delivery plus the manual wallet-reference flow and, when configured above, bKash for the
# advance. Stripe and SSLCommerz are NOT integrated (SSLCommerz is explicitly out of scope). These names are only
# validated by src/lib/env.ts so that old .env files keep loading.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# --- Fraud check (OPTIONAL, SERVER ONLY) ---------------------------------------------------------------------------------
# Supplies the trust score: courier-network parcel counts for the delivery phone, looked up on the server at checkout.
# The only provider is "steadfast": GET {STEADFAST_API_BASE_URL}/fraud_check/score/{phone}. It REUSES the Steadfast courier credentials above
# (STEADFAST_API_KEY, STEADFAST_API_SECRET, STEADFAST_API_BASE_URL, sent as the Api-Key / Secret-Key headers): there are NO separate fraud-check
# credentials, and FRAUD_CHECK_API_KEY / FRAUD_CHECK_API_BASE_URL are ignored by it. STEADFAST_ENABLED="false" also switches this check off.
# The adapter maps ONLY the exact integer fields delivered_count and cancelled_count. If an answer has no counts (percentages/bands only) it is
# treated as unavailable and the standard advance applies; nothing is estimated. NOT yet verified against a live call: leave it unset until you
# have checked one known phone number. While unset, every customer gets score 50, the standard advance and a staff review ("fallback policy").
# FRAUD_CHECK_PROVIDER="steadfast"
# FRAUD_CHECK_ENABLED="true"            # "false" switches the whole check off (reason "disabled")
# FRAUD_CHECK_TIMEOUT_MS="3000"         # 500-10000; a slower answer counts as unavailable and checkout continues
# FRAUD_CHECK_CACHE_SECONDS="600"       # 0-86400; how long a real answer is reused (0 = never). Failures are remembered for at most 30 s
# FRAUD_CHECK_MAX_CALLS_PER_MINUTE="60" # 1-1000; protects the provider quota; over budget = fallback policy, never a blocked checkout
# FRAUD_CHECK_API_KEY=""                # only for a future provider that needs its own key; ignored by "steadfast". NEVER prefix with NEXT_PUBLIC_
# FRAUD_CHECK_API_BASE_URL=""           # same: ignored by "steadfast" (use STEADFAST_API_BASE_URL)
