enum ConsentMode {
  OFF
  OPT_IN
}

// Audit trail of sourced goods arriving (one row per receipt operation).
model ProcurementReceipt {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?
  quantity          Int
  allocatedToOrders Int
  addedToStock      Int
  // What the received goods cost in total (cash out for procurement). Optional: unknown stays unknown.
  totalCost         Decimal? @db.Decimal(10, 2)
  adminId           String?
  note              String?
  createdAt         DateTime @default(now())
  // One key per form opening: a retried/double-clicked receipt returns the first result instead of allocating the goods twice.
  idempotencyKey    String?  @unique

  @@index([productId, createdAt])
}

enum RewardStatus {
  AVAILABLE
  USED
  EXPIRED
  REVOKED
}

// A customer-specific, one-time delivery-charge discount earned by a qualifying (delivered) order.
// The percentage/limits are SNAPSHOTS taken at issue time so later setting changes never rewrite history.
model CustomerReward {
  id             String       @id @default(cuid())
  userId         String
  orderId        String       @unique // the order that EARNED it: at most one reward per order (no duplicate issuance)
  code           String       @unique
  percent        Int
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  stackable      Boolean      @default(true)
  status         RewardStatus @default(AVAILABLE)
  expiresAt      DateTime?
  usedOrderId    String?      @unique // the order that REDEEMED it
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, status])
}

// Cached from the payout rows (see src/lib/settlement.ts). PENDING = nothing received, PARTIAL = some received, SETTLED = expected payout received.
enum SettlementStatus {
  NOT_APPLICABLE
  PENDING
  SETTLED
  PARTIAL
}

enum IncidentKind {
  DAMAGED_BEFORE_DISPATCH
  DAMAGED_IN_PACKAGING
  DAMAGED_BOX
  DAMAGED_IN_TRANSIT
  CUSTOMER_RETURN
  FAILED_DELIVERY
  REFUND
  COURIER_RETURN_FEE
  UNSELLABLE_WRITE_OFF
  OTHER
}

// What an incident does to SELLABLE stock. NONE = nothing; RESTOCK = units are sellable again (goes back on the shelf);
// WRITE_OFF = removes units that are ON the shelf (never for units an order already took); DISCARD = units that left with an order
// came back (or stay) unsellable: they remain OUT of sellable stock and can no longer be restocked.
enum IncidentStockEffect {
  NONE
  RESTOCK
  WRITE_OFF
  DISCARD
}

// A documented loss/return/refund event. Money fields are explicit and separate so nothing is counted twice:
//  lossAmount   = cost of goods/boxes that are gone (never together with RESTOCK: restocked goods are not a loss)
//  refundAmount = cash handed back to the customer
//  courierFee   = extra courier cost (return/re-delivery)
model FinancialIncident {
  id           String              @id @default(cuid())
  kind         IncidentKind
  occurredOn   DateTime            @db.Date
  orderId      String?
  orderItemId  String?
  productId    String?
  variantId    String?
  quantity     Int                 @default(0)
  stockEffect  IncidentStockEffect @default(NONE)
  lossAmount   Decimal             @default(0) @db.Decimal(10, 2)
  refundAmount Decimal             @default(0) @db.Decimal(10, 2)
  courierFee   Decimal             @default(0) @db.Decimal(10, 2)
  note         String?
  createdById  String?
  createdAt    DateTime            @default(now())
  // One key per form opening: a double-click/retry returns the first record instead of recording the same event twice.
  idempotencyKey String?           @unique

  @@index([occurredOn])
  @@index([orderId])
  @@index([orderItemId])
}

// A payout a marketplace (or other third party) ACTUALLY sent for ONE order. Append-only: the app never edits or deletes a row.
// `amount` is what arrived (it may be less than the expected payout: a partial settlement leaves the rest receivable).
// Duplicate protection: (orderId, reference) is unique per order, `idempotencyKey` makes a retried/double-clicked submit a no-op,
// and the service refuses any entry that would push the total received above the expected payout.
model MarketplaceSettlement {
  id             String   @id @default(cuid())
  orderId        String
  amount         Decimal  @db.Decimal(10, 2)
  receivedOn     DateTime @db.Date
  // The marketplace's payout / statement reference (normalised: no spaces, upper-case).
  reference      String?
  idempotencyKey String?  @unique
  note           String?
  // TRUE for rows back-filled from the old "SETTLED" flag, which assumed the full expected payout arrived. Disclosed on the Accounts page.
  legacyAssumed  Boolean  @default(false)
  recordedById   String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, reference])
  @@index([orderId])
  @@index([receivedOn])
}

// Append-only audit trail of sensitive staff actions (advance verified/rejected/waived, trust review, advance-policy changes).
// Staff-only: never selected into a customer-facing projection. `detail` holds the reason / before-after values.
model AdminAuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// Phase 5: a previous public slug of a product/category. The row stores the ENTITY id (not the new slug), so the
/// target is always the entity's current slug: chains collapse and a redirect loop is impossible.
model SlugRedirect {
  id         String   @id @default(cuid())
  entityType String // "PRODUCT" | "CATEGORY"
  oldSlug    String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([entityType, oldSlug])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Phase 6: customer experience
// ---------------------------------------------------------------------------

/// In-app notification (no external provider). `dedupeKey` makes a repeated trigger (the same status set twice, a retried
/// request) create ONE row per customer.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // ORDER | PAYMENT | REFUND | REVIEW | QUESTION
  title     String
  body      String?
  href      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// One row per (customer, product); viewedAt moves to "now" on every view and the oldest rows beyond 20 are pruned.
model RecentlyViewedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

enum QuestionStatus {
  PENDING
  APPROVED
  HIDDEN
}

/// A customer question about a product. Public only while APPROVED; the answer is the store's.
model ProductQuestion {
  id           String         @id @default(cuid())
  productId    String
  userId       String
  question     String
  answer       String?
  answeredAt   DateTime?
  answeredById String?
  status       QuestionStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 7: courier COD reconciliation
// ---------------------------------------------------------------------------

enum CourierCodEntryKind {
  COLLECTION_REPORTED // the courier reports it collected this much cash from the customer
  FEE_DEDUCTED // the courier deducted its delivery fee / COD charge (kept apart from the collected cash)
  SETTLEMENT_RECEIVED // the courier paid this much to the store
  ADJUSTMENT // a signed correction to the reported collection; requires a note
}

/// Append-only record of what a courier reported and paid for a COD order. It never creates revenue (the order already
/// counted it); it only lets staff compare expected cash, reported cash and settlement. Corrections are NEW ADJUSTMENT rows:
/// a database trigger refuses UPDATE and DELETE.
model CourierCodEntry {
  id          String              @id @default(cuid())
  orderId     String
  kind        CourierCodEntryKind
  amount      Decimal             @db.Decimal(10, 2)
  provider    String?
  /// The courier statement / settlement reference (used to refuse duplicate entries).
  reference   String?
  note        String?
  createdById String
  createdAt   DateTime            @default(now())
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([kind, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 7.1: online wallet gateway transactions
// ---------------------------------------------------------------------------

enum GatewayProvider {
  BKASH
  NAGAD
}

enum GatewayTxnStatus {
  INITIATED // created locally, provider payment not created yet
  PENDING_APPROVAL // provider payment exists; the customer has been sent to approve it
  VERIFYING // a server-side execute/query is in progress (claimed by exactly one request)
  SUCCEEDED // the provider confirmed it server-side; see paymentId for the credited local payment
  FAILED
  CANCELLED
  EXPIRED
  NEEDS_REVIEW // the provider took money but we could not credit it automatically (amount/invoice mismatch, order no longer payable)
}

enum GatewayRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One online payment attempt. Identifiers are kept apart on purpose:
///   id (internal) · merchantInvoiceNumber (ours, sent to the provider) · providerPaymentId (provider's payment id)
///   providerTrxId (the wallet transaction id; becomes Payment.providerRef when credited) · paymentId (the local Payment, created ONLY on verified success).
/// A failed/cancelled/expired/unverified attempt never creates a Payment and never touches advancePaid.
model GatewayTransaction {
  id                    String           @id @default(cuid())
  provider              GatewayProvider
  orderId               String
  purpose               PaymentKind      @default(ADVANCE)
  merchantInvoiceNumber String           @unique
  providerPaymentId     String?          @unique
  providerTrxId         String?
  status                GatewayTxnStatus @default(INITIATED)
  amount                Decimal          @db.Decimal(10, 2)
  currency              String           @default("BDT")
  environment           String // SANDBOX | PRODUCTION
  redirectUrl           String?
  providerStatus        String?
  providerStatusCode    String?
  failureReason         String?
  /// Raw provider payloads kept for troubleshooting (they contain no credentials).
  rawInitiate           Json?
  rawVerify             Json?
  paymentId             String?          @unique
  expiresAt             DateTime
  verifiedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  order                 Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment               Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refunds               GatewayRefund[]

  @@index([orderId])
  @@index([provider, status])
}

model GatewayRefund {
  id                    String              @id @default(cuid())
  transactionId         String
  amount                Decimal             @db.Decimal(10, 2)
  reason                String
  status                GatewayRefundStatus @default(PENDING)
  /// One admin submission = one key; a repeated submit can never create a second refund.
  idempotencyKey        String              @unique
  providerRefundTrxId   String?
  providerStatus        String?
  rawResponse           Json?
  /// The FinancialIncident (REFUND) that records this refund in the existing refund accounting. Null until it is recorded.
  incidentId            String?
  /// Set (atomically) just BEFORE the request is sent to the provider. Null = the request was never sent, so it is safe to send.
  /// Set while the status is still PENDING = the request MAY have reached the provider: never resend, query or resolve it.
  submittedAt           DateTime?
  /// When bKash's confirmation was first observed (or the date an admin attested from the bKash dashboard). Never rewritten.
  providerConfirmedAt   DateTime?
  /// When the refund was written to accounting (may be later than providerConfirmedAt after a retry).
  accountingRecordedAt  DateTime?
  /// Admin resolution of an uncertain refund (always with a note).
  resolvedAt            DateTime?
  resolvedById          String?
  resolutionNote        String?
  /// Where the admin saw the outcome (dashboard screenshot id, support ticket, statement line): required for a manual resolution.
  resolutionEvidence    String?
  /// Optional second-admin approval for high-value attestations: a PROPOSAL waits here until a DIFFERENT admin approves it.
  proposedOutcome       String?
  proposedTrxId         String?
  proposedConfirmedOn   DateTime?
  proposedEvidence      String?
  proposedNote          String?
  proposedById          String?
  proposedAt            DateTime?
  requestedById         String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  transaction           GatewayTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
}
